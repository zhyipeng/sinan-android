<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
  <item android:id="@android:id/background" android:gravity="center_vertical">
    <shape android:shape="rectangle">
      <size android:height="6dp" />
      <corners android:radius="3dp" />
      <solid android:color="@color/surface_subtle" />
    </shape>
  </item>
  <item android:id="@android:id/progress" android:gravity="center_vertical">
    <clip>
      <shape android:shape="rectangle">
        <size android:height="6dp" />
        <corners android:radius="3dp" />
        <solid android:color="@color/brand_accent" />
      </shape>
    </clip>
  </item>
</layer-list>
